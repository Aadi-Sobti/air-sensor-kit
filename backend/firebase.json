{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/v1/health",
        "function": {
          "functionId": "health",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/v1/ingest",
        "function": {
          "functionId": "ingest",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/v1/claim",
        "function": {
          "functionId": "claim",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/v1/snapshot.json",
        "function": {
          "functionId": "snapshot",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/v1/owner/**",
        "function": {
          "functionId": "owner",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/v1/sensor/**",
        "function": {
          "functionId": "history",
          "region": "us-east1"
        }
      },
      {
        "source": "/s/**",
        "destination": "/s.html"
      },
      {
        "source": "/my",
        "destination": "/my.html"
      }
    ],
    "predeploy": [
      "bash ../tools/check_site_assets.sh",
      "npm --prefix ../web run build",
      "rm -rf public && cp -R ../web/dist public"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Permissions-Policy",
            "value": "serial=(self), camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5050
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "storage": {
    "rules": "storage.rules"
  }
}
