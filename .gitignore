# Secrets: never commit
.env
.env.*
!.env.example
# Non-secret function parameters per project (e.g. the Sensor.Community flag) are committed on purpose.
!backend/functions/.env.prosefire-dev
secrets/
*service-account*.json
# Private signing keys only. Public keys and pinned root CAs ARE committed.
*private*.key
*private*.pem

# Logs and captures
logs/

# PlatformIO
firmware/.pio/
.pio/

# Node / Firebase
node_modules/
backend/functions/lib/
.firebase/
firebase-debug.log
*-debug.log

# Python
.venv/
__pycache__/
*.pyc

# Factory station output (contains chip IDs)
tools/out/

# OS / editor
.DS_Store
.vscode/

# Web build output
web/dist/
backend/functions/lib-test/
backend/public/
web/public/tiles/
web/public/fonts/
backend/functions/.secret.local

# OTA images + manifest (generated by tools/ota_publish.py, deployed with Hosting)
web/public/fw/

# KiCad (hardware/beacon-driver-pcb): local and regenerated files
*.kicad_prl
*-backups/
fp-info-cache
hardware/beacon-driver-pcb/*.rpt
hardware/beacon-driver-pcb/jlcpcb/gerbers/
